# --- Database ---------------------------------------------------------------
# Shared external Postgres. Provision a `visualize` database + user + password
# on your shared instance. Set this URL on ingest, viewer, and mcp.
DATABASE_URL="postgresql://visualize:CHANGE_ME@your-shared-postgres-host:5432/visualize?schema=public"

# --- Ingest service (CI-facing, shared-secret auth) -------------------------
# CI sends `Authorization: Bearer <token>`. Generate: openssl rand -hex 32
API_SECRET="change-me-to-a-long-random-string"

# --- Storage ----------------------------------------------------------------
# Where extracted Playwright report bundles live. Mounted into all services
# via the `visualize-data` named volume in docker-compose.yml.
DATA_DIR="/var/lib/visualize/data"

# --- Viewer service (Authentik OIDC) ----------------------------------------
# Public URL of the viewer (drives OIDC redirect URI + cookie domain).
VIEWER_URL="https://visualize.example.com"
# Generate: openssl rand -hex 32
AUTH_SECRET="change-me-another-long-random-string"

# Authentik OIDC application. Set redirect URI in Authentik to:
#   ${VIEWER_URL}/api/auth/callback/authentik
AUTHENTIK_ISSUER="https://authentik.example.com/application/o/visualize/"
AUTHENTIK_CLIENT_ID=""
AUTHENTIK_CLIENT_SECRET=""

# --- MCP service (Claude-facing, shared-secret auth) ------------------------
# Claude Code sends `Authorization: Bearer <token>`. Use a different secret
# from API_SECRET so they can be rotated independently.
MCP_SECRET="change-me-yet-another-long-random-string"

# --- Local dev only ---------------------------------------------------------
POSTGRES_DEV_PASSWORD="visualize"
