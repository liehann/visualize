{
  "name": "@visualize/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./auth-middleware": {
      "types": "./dist/auth-middleware.d.ts",
      "default": "./dist/auth-middleware.js"
    },
    "./snapshot_path": {
      "types": "./dist/snapshot_path.d.ts",
      "default": "./dist/snapshot_path.js"
    },
    "./diff_metrics": {
      "types": "./dist/diff_metrics.d.ts",
      "default": "./dist/diff_metrics.js"
    },
    "./data_dir_check": {
      "types": "./dist/data_dir_check.d.ts",
      "default": "./dist/data_dir_check.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^2.10.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
